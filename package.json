{
  "name": "mini-pdf",
  "version": "0.0.2",
  "description": "mini-pdf — a tiny PDF writer in TypeScript",
  "author": "Stefan Huber <sh@signalwerk.ch>",
  "repository": "https://github.com/signalwerk/mini-pdf",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "demo": "vite-node examples/demo.ts",
    "demo:watch": "vite-node --watch examples/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist examples/output"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-node": "^1.5.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "fixed-size-array": "^0.1.1",
    "fontkit": "^2.0.4"
  }
}
